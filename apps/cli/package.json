{
  "name": "@arcals/cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "arcals": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arcals/contract-bindings": "workspace:*",
    "@arcals/protocol": "workspace:*",
    "@arcals/randomx-tools": "workspace:*",
    "@arcals/sdk": "workspace:*",
    "viem": "2.56.3"
  }
}
